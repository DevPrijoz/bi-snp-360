# DADOS INTERNOS NUNCA DEVEM SER COLOCADOS NO FRONTEND PUBLICO.
# OIDC institucional: exige iss, aud, exp, iat, sub e assinatura RS256.
OIDC_ISSUER=https://idp.institucional.exemplo/realms/snp
OIDC_AUDIENCE=snp360-api
OIDC_JWKS_URL=https://idp.institucional.exemplo/realms/snp/protocol/openid-connect/certs
# Banco SQLite APENAS no piloto local. Producao: Postgres gerenciado/validado pela TI.
DATABASE_URL=sqlite:///./data/snp360_pilot.db
# Ativar somente na primeira execucao de desenvolvimento, nunca em producao.
SNP_AUTO_CREATE_SCHEMA=1
